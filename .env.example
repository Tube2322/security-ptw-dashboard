# Supabase — fill in from your project's API settings, then copy this file to .env.local
# The anon key is designed to be public: it is shipped to the browser and Row Level Security,
# not secrecy, is what protects the data. Never put the service_role key in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
